{
 "app": {"title": "Notes", "notes": ["Dates use UTC and the shared clock 2026-01-01T09:00:00Z."]},
 "auth": {"accounts": false},
 "tables": [{"name": "notes", "columns": ["id INTEGER PRIMARY KEY AUTOINCREMENT", "title TEXT NOT NULL", "body TEXT NOT NULL DEFAULT ''", "created_at TEXT NOT NULL"]}],
 "seed": [],
 "api": [
  {"method": "GET", "path": "/api/notes", "request": {}, "response": "{\"notes\": [{\"id\": 1, \"title\": \"...\"}]}", "errors": [], "reqs": ["REQ-1.1"]},
  {"method": "POST", "path": "/api/notes", "request": {"title": "string", "body": "string"}, "response": "{\"note\": {\"id\": 1, \"title\": \"...\", \"body\": \"...\"}}", "errors": ["400 {\"error\": \"Title is required\"}"], "reqs": ["REQ-1.2"]},
  {"method": "GET", "path": "/api/notes/:id", "request": {}, "response": "{\"note\": {\"id\": 1, \"title\": \"...\", \"body\": \"...\"}}", "errors": ["404 {\"error\": \"Note not found\"}"], "reqs": ["REQ-1.2", "REQ-1.3"]},
  {"method": "DELETE", "path": "/api/notes/:id", "request": {}, "response": "{\"ok\": true}", "errors": ["404 {\"error\": \"Note not found\"}"], "reqs": ["REQ-1.3"]}
 ],
 "layout": {"controls": [{"role": "link", "name": "Notes", "to": "/notes", "when": "always"}]},
 "pages": [
  {"id": "home", "route": "/", "title": "Notes", "layout": true, "module": "m1", "reqs": ["REQ-1.1"], "controls": [], "shows": ["a short welcome text"], "flows": []},
  {"id": "notes", "route": "/notes", "title": "Notes", "layout": true, "module": "m1", "reqs": ["REQ-1.1", "REQ-1.2", "REQ-1.3"],
   "controls": [{"role": "region", "name": "Note list", "when": "always"}, {"role": "link", "name": "Create Note", "when": "always"}],
   "shows": ["each note once, as a link named by its title, inside Note list"], "flows": []},
  {"id": "note_new", "route": "/notes/new", "title": "Create Note", "layout": true, "module": "m1", "reqs": ["REQ-1.2"],
   "controls": [{"role": "textbox", "name": "Title", "when": "always"}, {"role": "textbox", "name": "Body", "when": "always"}, {"role": "button", "name": "Save Note", "when": "always"}, {"role": "button", "name": "Cancel", "when": "always"}],
   "shows": [], "flows": ["Save Note: POST /api/notes, then open /notes/:id", "Cancel: open /notes without saving"]},
  {"id": "note", "route": "/notes/:id", "title": "Note", "layout": true, "module": "m1", "reqs": ["REQ-1.2", "REQ-1.3"],
   "controls": [{"role": "button", "name": "Delete", "when": "always"}, {"role": "button", "name": "Confirm Delete", "when": "after Delete"}, {"role": "button", "name": "Cancel", "when": "after Delete"}],
   "shows": ["the note title as an h1", "the note body"], "flows": ["Confirm Delete: DELETE /api/notes/:id, then open /notes"]}
 ],
 "modules": [{"id": "m1", "pages": ["home", "notes", "note_new", "note"]}]
}
