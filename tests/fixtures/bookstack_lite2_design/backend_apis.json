            "body": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "enum": [
                    "invalid_title"
                  ]
                }
              },
              "required": [
                "error"
              ]
            },
            "headers": {
              "type": "object"
            }
          },
          {
            "status": 409,
            "body": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "enum": [
                    "page_title_exists"
                  ]
                }
              },
              "required": [
                "error"
              ]
            },
            "headers": {
              "type": "object"
            }
          }
        ]
      },
      "precondition": [
        {
          "id": "P-create-page-book-exists",
          "description": "A book with the requested bookId exists in the public book workspace.",
