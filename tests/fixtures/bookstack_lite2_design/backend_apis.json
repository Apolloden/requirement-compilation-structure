{
  "apis": {
    "API-list-books": {
      "description": "List persisted books in the public book workspace for rendering the Books page; available without authentication so anonymous visitors can open the workspace and reload it.",
      "read": [
        "Book.id",
        "Book.title"
      ],
      "write": [],
      "signature": {
        "name": "listBooks",
        "method": "GET",
        "path": "/api/books"
      },
      "request": {
        "params": {
          "type": "object"
        },
        "query": {
          "type": "object"
        },
        "body": {
          "type": "object"
        },
        "headers": {
          "type": "object"
        }
      },
      "response": {
        "success": {
          "status": 200,
          "body": {
            "type": "object",
            "properties": {
              "books": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title"
                  ]
                }
              }
            },
            "required": [
              "books"
            ]
          },
          "headers": {
            "type": "object"
          }
        },
        "errors": []
      },
      "precondition": [],
      "postcondition": [
        {
          "id": "Q-list-books",
          "description": "Return all persisted books, including an empty list when none exist, without changing any records; response is available to anonymous visitors and supports navigation and reload of the book workspace",
          "status": 200
        }
      ]
    },
    "API-get-book": {
      "description": "Retrieve one persisted book by its identifier for the book detail and edit form, returning its saved business name as the heading title, its saved description, its saved tags, and its persisted Page list entries as identifying id/title pairs; available to anonymous visitors so detail pages can be reloaded or opened directly.",
      "read": [
        "Book.id",
        "Book.title",
        "Book.description",
        "Book.tags",
        "Page.book_id",
        "Page.id",
        "Page.title"
      ],
      "write": [],
      "signature": {
        "name": "getBook",
        "method": "GET",
        "path": "/api/books/{bookId}"
      },
      "request": {
        "params": {
          "type": "object",
          "properties": {
            "bookId": {
              "type": "string",
              "format": "uuid",
              "description": "Identifier of the book selected from the Book list."
            }
          },
          "required": [
            "bookId"
          ]
        },
        "query": {
          "type": "object"
        },
        "body": {
          "type": "object"
        },
        "headers": {
          "type": "object"
        }
      },
      "response": {
        "success": {
          "status": 200,
          "body": {
            "type": "object",
            "properties": {
              "book": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "pages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "title": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "title"
                      ]
                    }
                  }
                },
                "required": [
                  "id",
                  "title",
                  "description",
                  "tags",
                  "pages"
                ]
              }
            },
            "required": [
              "book"
            ]
          },
          "headers": {
            "type": "object"
          }
        },
        "errors": [
          {
            "status": 404,
            "body": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "enum": [
                    "book_not_found"
                  ]
                }
              },
              "required": [
                "error"
              ]
            },
            "headers": {
              "type": "object"
            }
          }
        ]
      },
      "precondition": [
        {
          "id": "P-book-exists",
          "description": "A book with the requested bookId exists in the public book workspace.",
          "error_status": 404
        }
      ],
      "postcondition": [
        {
          "id": "Q-get-book",
          "description": "Return the persisted book id, title, saved description, saved tags, and the book's persisted page list entries as id/title pairs, including an empty pages list when no pages exist, without changing any records; anonymous visitors can reload or directly open the book detail page and see the saved Page list.",
          "status": 200
        },
        {
          "id": "Q-get-book-not-found",
          "description": "When no matching book exists, return book_not_found and leave all persisted records unchanged.",
          "status": 404
        }
      ]
    },
    "API-create-book": {
      "description": "Create exactly one new book in the public book workspace from submitted name, description and tags; available to anonymous visitors, returning the persisted book metadata for the detail view.",
      "read": [
        "Book.title"
      ],
      "write": [
        "Book.created_at",
        "Book.description",
        "Book.id",
        "Book.tags",
        "Book.title"
      ],
      "signature": {
        "name": "createBook",
        "method": "POST",
        "path": "/api/books"
      },
      "request": {
        "params": {
          "type": "object"
        },
        "query": {
          "type": "object"
        },
        "body": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Book name/title entered in the Name field; uniquely identifies the book."
            },
            "description": {
              "type": [
                "string",
                "null"
              ],
              "description": "Saved description entered in the Description field."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tags entered in the comma-separated Tags field, persisted as an array of tag strings."
            }
          },
          "required": [
            "title",
            "description",
            "tags"
          ]
        },
        "headers": {
          "type": "object"
        }
      },
      "response": {
        "success": {
          "status": 201,
          "body": {
            "type": "object",
            "properties": {
              "book": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "created_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "description",
                  "tags",
                  "created_at"
                ]
              }
            },
            "required": [
              "book"
            ]
          },
          "headers": {
            "type": "object"
          }
        },
        "errors": [
          {
            "status": 400,
            "body": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "enum": [
                    "invalid_title"
                  ]
                }
              },
              "required": [
                "error"
              ]
            },
            "headers": {
              "type": "object"
            }
          },
          {
            "status": 409,
            "body": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "enum": [
                    "book_title_exists"
                  ]
                }
              },
              "required": [
                "error"
              ]
            },
            "headers": {
              "type": "object"
            }
          }
        ]
      },
      "precondition": [
        {
          "id": "P-create-book-title-nonempty",
          "description": "The submitted book title must not be empty.",
          "error_status": 400
        },
        {
          "id": "P-create-book-title-unique",
          "description": "No persisted book already uses the submitted title as its business name.",
          "error_status": 409
        }
      ],
      "postcondition": [
        {
          "id": "Q-create-book",
          "description": "Persist exactly one book with a generated id, the submitted title, description and tag list, and a created_at timestamp; return the persisted book metadata and make it available for anonymous detail reloads and later reads.",
          "status": 201
        },
        {
          "id": "Q-create-book-invalid",
          "description": "When the title is empty, return invalid_title and leave all persisted records unchanged.",
          "status": 400
        },
        {
          "id": "Q-create-book-duplicate",
          "description": "When a book with the same title already exists, return book_title_exists and leave all persisted records unchanged.",
          "status": 409
        }
      ]
    },
