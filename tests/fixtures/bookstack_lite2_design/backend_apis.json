    "API-delete-book": {
      "description": "Delete one persisted book from the public book workspace after the user confirms deletion; available to anonymous visitors. The deleted book no longer appears in subsequent Books list reads or reloads.",
      "read": [
        "Book.id"
      ],
      "write": [
        "Book.id"
      ],
      "signature": {
        "name": "deleteBook",
        "method": "DELETE",
        "path": "/api/books/{bookId}"
      },
      "request": {
        "params": {
          "type": "object",
          "properties": {
            "bookId": {
              "type": "string",
              "format": "uuid",
              "description": "Identifier of the book selected for deletion."
            }
          },
          "required": [
            "bookId"
          ]
        },
        "query": {
          "type": "object"
        },
        "body": {
          "type": "object"
        },
        "headers": {
          "type": "object"
        }
      },
      "response": {
        "success": {
          "status": 200,
          "body": {
            "type": "object",
            "properties": {
              "deleted": {
                "type": "boolean",
                "const": true
              },
              "bookId": {
                "type": "string",
                "format": "uuid",
                "description": "Identifier of the book that was removed."
              }
            },
            "required": [
              "deleted",
              "bookId"
            ]
          },
          "headers": {
            "type": "object"
          }
        },
        "errors": [
          {
            "status": 404,
            "body": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "enum": [
                    "book_not_found"
                  ]
                }
              },
              "required": [
                "error"
              ]
            },
            "headers": {
              "type": "object"
            }
          }
        ]
      },
      "precondition": [
        {
          "id": "P-delete-book-exists",
          "description": "A book with the requested bookId exists in the public book workspace.",
          "error_status": 404
        }
      ],
      "postcondition": [
        {
          "id": "Q-delete-book",
          "description": "Permanently remove the identified book and its persisted fields from the public book workspace, so subsequent Books list reads and reloads contain no entry for that book; return deleted=true with the removed bookId.",
