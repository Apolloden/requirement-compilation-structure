          },
          {
            "status": 400,
            "body": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "enum": [
                    "invalid_title"
                  ]
                }
              },
              "required": [
                "error"
              ]
            },
            "headers": {
              "type": "object"
            }
          },
          {
            "status": 409,
            "body": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "enum": [
                    "book_title_exists"
                  ]
                }
              },
              "required": [
                "error"
              ]
            },
            "headers": {
              "type": "object"
            }
