      ],
      "postcondition": [
        {
          "id": "Q-update-book",
          "description": "Persist the submitted title, description, and tag list on the identified existing book, preserving its id and creation timestamp; return the saved book metadata so the detail heading and description reflect the changes and remain retrievable after reload via API-get-book.",
