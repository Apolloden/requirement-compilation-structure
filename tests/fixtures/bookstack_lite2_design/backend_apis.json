          "id": "P-update-book-title-nonempty",
          "description": "The submitted replacement book title must not be empty.",
          "error_status": 400
        },
        {
          "id": "P-update-book-title-unique",
          "description": "No other persisted book already uses the submitted title as its business name; the book being edited may keep its existing title.",
          "error_status": 409
