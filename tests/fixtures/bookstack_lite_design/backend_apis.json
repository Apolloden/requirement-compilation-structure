              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            },
            "headers": {
              "type": "object"
            }
          }
        ]
      },
      "precondition": [
        {
          "id": "P-create-page-book-exists",
          "description": "A persisted book with the requested bookId exists",
          "error_status": 404
        },
        {
          "id": "P-create-page-title-unique-in-book",
          "description": "No persisted page in the same parent book already has the submitted title",
          "error_status": 409
