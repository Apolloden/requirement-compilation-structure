        },
        "errors": [
          {
            "status": 409,
            "body": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            },
            "headers": {
              "type": "object"
            }
          }
        ]
      },
      "precondition": [
        {
          "id": "P-title-unique",
          "description": "No persisted book already has the submitted title",
          "error_status": 409
        }
      ],
      "postcondition": [
        {
          "id": "Q-create-book",
          "description": "Persist exactly one book with a generated id and created_at, and return its saved id, title, description, tags and created_at",
          "status": 201
        },
        {
          "id": "Q-create-book-duplicate",
          "description": "When a book with the submitted title already exists, return 409 and leave all book records unchanged",
          "status": 409
        }
      ]
