                "error"
              ]
            },
            "headers": {
              "type": "object"
            }
          }
        ]
      },
      "precondition": [
        {
          "id": "P-book-exists",
          "description": "A persisted book with the requested id exists",
          "error_status": 404
        }
      ],
      "postcondition": [
        {
          "id": "Q-get-book",
          "description": "Return the selected book's id, title, saved description and tags without changing any stored record",
