    "API-create-book": {
      "description": "Create exactly one persisted book from the anonymous Create New Book form and return its saved metadata for the new book detail view.",
      "read": [
        "Book.title"
      ],
      "write": [
        "Book.id",
        "Book.title",
        "Book.description",
        "Book.tags",
        "Book.created_at"
      ],
      "signature": {
        "name": "createBook",
        "method": "POST",
        "path": "/api/books"
      },
      "request": {
        "params": {
          "type": "object"
        },
        "query": {
          "type": "object"
        },
        "body": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Book business name; must be unique across persisted books."
            },
            "description": {
              "type": [
                "string",
                "null"
              ],
              "description": "Optional saved description for the book."
            },
            "tags": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              },
              "description": "Optional tag labels saved with the book."
            }
          },
          "required": [
            "title"
          ]
        },
        "headers": {
          "type": "object"
        }
      },
      "response": {
        "success": {
          "status": 201,
          "body": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string",
                "description": "Saved book business name shown as the new book heading."
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Saved book description; null when none was recorded."
              },
              "tags": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Saved tag labels; null when none were recorded."
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "id",
              "title",
              "description",
              "tags",
              "created_at"
            ]
          },
          "headers": {
            "type": "object"
