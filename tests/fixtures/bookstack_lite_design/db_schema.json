      "Book.tags",
      "Book.title"
    ],
    "REQ-2.5": [
      "Book.description",
      "Book.id",
      "Book.title"
    ],
    "REQ-3.1": [
      "Book.id",
      "Book.title",
      "Page.body",
      "Page.book_id",
      "Page.created_at",
      "Page.id",
      "Page.title"
    ],
    "REQ-3.2": [
