      "Book.id",
      "Book.title"
    ],
    "REQ-2.3": [
      "Book.created_at",
      "Book.description",
      "Book.id",
      "Book.tags",
      "Book.title"
    ],
    "REQ-2.4": [
      "Book.created_at",
